{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examforge.invalid/schemas/exam-ir-v1.json",
  "title": "ExamForge Exam IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exam_id", "metadata", "assets", "questions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "exam_id": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "subject"],
      "properties": {
        "title": {"$ref": "#/$defs/plainText", "minLength": 1}, "subtitle": {"$ref": "#/$defs/plainText"},
        "subject": {"type": "string", "enum": ["mathematics", "chinese", "english", "physics", "chemistry", "biology", "history", "geography", "politics", "other"]},
        "grade": {"$ref": "#/$defs/plainText"}, "total_score": {"type": "number", "minimum": 0},
        "duration_minutes": {"type": "integer", "minimum": 1}, "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "assets": {"type": "object", "maxProperties": 1024, "propertyNames": {"pattern": "^ast_[A-Za-z0-9_-]+$"}, "additionalProperties": {"$ref": "#/$defs/asset"}},
    "questions": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/question"}},
    "sections": {"type": "array", "maxItems": 512, "items": {"type": "object", "maxProperties": 64}}
  },
  "$defs": {
    "plainText": {"type": "string", "maxLength": 65536, "description": "Bounded text field; inline parsing applies only to fields documented as inline content"},
    "inlineText": {"type": "string", "maxLength": 65536},
    "bbox": {"type": "object", "additionalProperties": false, "required": ["page", "rect"], "properties": {"page": {"type": "integer", "minimum": 1}, "rect": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["asset_id", "media_type", "uri", "status"], "properties": {"asset_id": {"type": "string", "maxLength": 128, "pattern": "^ast_[A-Za-z0-9_-]+$"}, "media_type": {"type": "string", "maxLength": 128, "minLength": 1}, "uri": {"type": "string", "maxLength": 4096, "minLength": 1}, "raw_uri": {"type": "string", "maxLength": 4096}, "status": {"type": "string", "enum": ["raw_cropped", "cleaned", "vectorized"]}, "aspect_ratio": {"type": "number", "exclusiveMinimum": 0}, "suggested_width_mm": {"type": "number", "exclusiveMinimum": 0}, "caption": {"$ref": "#/$defs/plainText"}, "alt": {"$ref": "#/$defs/plainText"}, "source_bbox": {"$ref": "#/$defs/bbox"}}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"$ref": "#/$defs/inlineText"}, "colspan": {"type": "integer", "minimum": 1, "maximum": 64}, "rowspan": {"type": "integer", "minimum": 1, "maximum": 512}}},
    "cellRow": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/cell"}},
    "table": {"type": "object", "additionalProperties": false, "required": ["headers", "rows"], "properties": {"headers": {"oneOf": [{"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/cellRow"}, "minItems": 1}, {"$ref": "#/$defs/cellRow"}]}, "rows": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/cellRow"}}}},
    "block": {"description": "Core types are text, math_block, image_ref, table. The type namespace is open for future disciplines, e.g. chem_block and writing_grid.", "type": "object", "required": ["type"], "properties": {"type": {"type": "string", "maxLength": 128, "minLength": 1}, "markdown": {"$ref": "#/$defs/inlineText", "description": "Markdown with inline LaTeX and {{blank:N}} placeholders"}, "latex": {"type": "string", "maxLength": 65536}, "asset_id": {"type": "string", "maxLength": 128, "pattern": "^ast_[A-Za-z0-9_-]+$"}, "layout_hint": {"type": "string", "enum": ["center", "float_right", "inline", "grid_item"]}, "table": {"$ref": "#/$defs/table"}}, "allOf": [{"if": {"properties": {"type": {"const": "text"}}, "required": ["type"]}, "then": {"required": ["markdown"]}}, {"if": {"properties": {"type": {"const": "math_block"}}, "required": ["type"]}, "then": {"required": ["latex"]}}, {"if": {"properties": {"type": {"const": "image_ref"}}, "required": ["type"]}, "then": {"required": ["asset_id", "layout_hint"]}}, {"if": {"properties": {"type": {"const": "table"}}, "required": ["type"]}, "then": {"required": ["table"]}}]},
    "answer": {"type": "object", "additionalProperties": false, "properties": {"short_values": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/inlineText"}}, "detail": {"$ref": "#/$defs/blocks"}}},
    "blocks": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/block"}},
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "display_number", "stem"],
      "properties": {
        "kind": {"type": "string", "enum": ["single", "composite"]},
        "display_number": {"type": "string", "maxLength": 128}, "question_type": {"type": "string", "maxLength": 128}, "score": {"type": "number", "minimum": 0},
        "stem": {"$ref": "#/$defs/blocks"},
        "options": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["label", "content"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 128}, "content": {"$ref": "#/$defs/blocks"}}}},
        "answer_space_mm": {"type": "number", "minimum": 0}, "answer": {"$ref": "#/$defs/answer"},
        "analysis": {"$ref": "#/$defs/blocks"},
        "children": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/question"}},
        "metadata": {"type": "object", "additionalProperties": false, "maxProperties": 64, "properties": {"knowledge_points": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/plainText"}}, "difficulty": {"type": "number", "minimum": 0, "maximum": 1}, "dedup_fingerprint": {"type": "string", "maxLength": 256}}},
        "provenance": {"type": "object", "additionalProperties": false, "maxProperties": 64, "properties": {"bboxes": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/bbox"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "review_status": {"type": "string", "maxLength": 128}, "warnings": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/plainText"}}}}
      }
    }
  }
}
