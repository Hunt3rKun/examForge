{
  "name": "examforge-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.0.0", "npm": ">=9.2.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-api-types": "node scripts/generate-api-types.mjs",
    "typegen:check": "node scripts/verify-generated-api.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "katex": "0.16.21",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/katex": "0.16.7",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.6.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
